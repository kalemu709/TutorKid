# Production (Cloud Run) settings for ./scripts/deploy-cloud-run.sh. Loaded after common.env.
# Committed: holds NO secret values. Secrets live in Google Secret Manager; only their
# *names* are listed here. The deploy script creates missing secrets for you.

# --- App settings (passed as Cloud Run env vars) ---
AUTH_DEV_MODE=0
SESSION_COOKIE_SECURE=1

# --- Secret Manager names (mounted as DATABASE_URL / OPENAI_API_KEY; the Firebase key's
#     name, FIREBASE_CREDENTIALS_SECRET, is in common.env) ---
DATABASE_URL_SECRET=database-url
# Leave empty to skip wiring OpenAI:
OPENAI_API_KEY_SECRET=openai-api-key

# --- Cloud Run deploy ---
GCP_REGION=us-west2
CLOUD_RUN_SERVICE=hanzi-practice
ARTIFACT_REPO=hanzi
# auto = git sha (+ "-dirty-<timestamp>" with uncommitted changes); or set a fixed tag.
IMAGE_TAG=auto
# PaddleOCR needs more than the Cloud Run default (512Mi); 2Gi/2 CPU is enough for image read.
CLOUD_RUN_MEMORY=2Gi
CLOUD_RUN_CPU=2
CLOUD_RUN_TIMEOUT=300
CLOUDSQL_CONNECTION=hanzi-practice-hw-2026:us-west2:lazy-parent
CLOUD_RUN_SERVICE_ACCOUNT=hanzi-practice-runtime@hanzi-practice-hw-2026.iam.gserviceaccount.com
