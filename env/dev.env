# Local development (Python on the host or Docker Compose). Loaded after common.env.
# Committed: local-only values, no real secrets. Put personal overrides and real keys
# (OPENAI_API_KEY, ...) in env/local.env, which is gitignored.

# Docker Compose Postgres. Inside Compose the app overrides the host to `db`.
DATABASE_URL=postgresql://tutorkid:tutorkid@127.0.0.1:54329/tutorkid

# 1 = local-dev sign-in form (HMAC dev tokens). ./scripts/dev-firebase.sh forces 0 and
# reads the Firebase Admin key from Secret Manager.
AUTH_DEV_MODE=1
AUTH_DEV_SECRET=local-dev-secret-change-me
SESSION_COOKIE_SECURE=0
